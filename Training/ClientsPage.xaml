<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Training.ClientsPage"
             Title="ClientsPage">
    <Grid Padding="20" RowDefinitions="Auto,Auto">

        <Label Grid.Row="0" Text="Clientes" FontSize="24" FontAttributes="Bold" Margin="0,0,0,10" />

        <CollectionView Grid.Row="1" x:Name="ClientsCollectionView">
            <CollectionView.Header>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="10,5" BackgroundColor="LightGray">
                    <Label Grid.Column="0" Text="ID" FontAttributes="Bold" WidthRequest="40" />
                    <Label Grid.Column="1" Text="Nome" FontAttributes="Bold" />
                    <Label Grid.Column="2" Text="Cidade" FontAttributes="Bold" WidthRequest="90" />
                    <Label Grid.Column="3" Text="Registo" FontAttributes="Bold" WidthRequest="100" />
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="10,8">
                        <Label Grid.Column="0" Text="{Binding [id]}" WidthRequest="40" />
                        <Label Grid.Column="1" Text="{Binding [nome]}" />
                        <Label Grid.Column="2" Text="{Binding [cidade]}" WidthRequest="90" />
                        <Label Grid.Column="3" Text="{Binding [data_registo]}" WidthRequest="100" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
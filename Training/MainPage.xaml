<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Training.MainPage">

    <Grid Padding="20" RowDefinitions="Auto,*">

        <Label Grid.Row="0" Text="Clientes e Encomendas" FontSize="24" FontAttributes="Bold" Margin="0,0,0,10" />

        <CollectionView Grid.Row="1" x:Name="ProdutosCollectionView">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,Auto,Auto" Padding="10,5" BackgroundColor="LightGray">
                    <Label Grid.Column="0" Text="Cliente" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="Encomenda" FontAttributes="Bold" WidthRequest="90" />
                    <Label Grid.Column="2" Text="Data" FontAttributes="Bold" WidthRequest="100" />
                </Grid>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="10,8">
                        <Label Grid.Column="0" Text="{Binding [cliente_nome]}" />
                        <Label Grid.Column="1" Text="{Binding [encomenda_id]}" WidthRequest="90" />
                        <Label Grid.Column="2" Text="{Binding [data_encomenda]}" WidthRequest="100" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>